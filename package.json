{
    "name": "passion4profession-blog",
    "private": true,
    "version": "1.0.0",
    "engines": {
        "node": "^22.12.0 || >=24.0.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "generate:blogs": "node src/scripts/generateBlogJson.js",
        "build": "npm run generate:blogs && vite build",
        "preview": "vite preview",
        "predeploy": "npm run build && node -e \"require('node:fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
        "deploy": "gh-pages -d dist -b gh-pages",
        "lint": "eslint ."
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.13.1",
        "styled-components": "^6.1.18"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "gh-pages": "^6.1.1",
        "globals": "^17.12.0",
        "vite": "^8.3.7"
    },
    "description": "Beginner-friendly technical blog with practical articles on computing, software, networking, operating systems, and cybersecurity.",
    "homepage": "https://a2rp.github.io/passion4profession-blog/"
}
